# editaplot-dsh ignores — mirror the upstream policy plus DSH-specific bits.

# Local Python env created by the MCP bridge on first install.
.venv/
__pycache__/
*.pyc

# Build output produced by `pnpm run prepare`.
node_modules/
lib/

# npm publish state — never commit credentials, only this empty
# marker is tracked. The real .npmrc lives at $HOME/.npmrc and is
# user-specific.
.npmrc
.npm-cache/
editaplot-dsh-*.tgz

# Per-developer DSH state and local renders.
.DSH_HOME/
*.opju
*.png
*.pdf
*.tif
*.tif.tmp

